{
  "name": "biblical-kingdoms-map",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive map of Biblical kingdoms and empires from 2000 BC to 2026, with a timeline, cities, trade routes and journeys.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "docs:pdf": "node scripts/make-pdf.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.1.2",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
